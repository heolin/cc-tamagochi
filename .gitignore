# Host environment
.venv/
__pycache__/
*.pyc

# Left behind by `uv pip install -e .` - build metadata, not source
*.egg-info/

# Runtime state: the pet itself. Generated on first run, and personal.
bridge/buddy.json
bridge/buddy.json.bak
bridge/buddy.json.tmp

# Written by ./configure.py before it overwrites the settings. The committed
# buddy_config.json is the shipped default; a backup of somebody's own answers
# is theirs, not the repo's.
bridge/buddy_config.json.bak
bridge/buddy_config.json.tmp

# Written by device/deploy_app.sh on whichever machine it runs on
device/backup/

# Sprite previews are regenerated by tools/sprite_convert.py --png
/preview/

# The mascot artwork is licensed to whoever downloaded it, not to this repo, so
# the source PNGs stay out of git - see device/raw_images/README.md. The .spr
# files converted from them are committed, so nobody needs the pack to run the
# buddy.
device/raw_images/*.png

# device/sprites/*.spr is deliberately NOT ignored: committing it means a user
# can deploy without installing Pillow, and the files are a few hundred bytes.
