# Host environment
.venv/
__pycache__/
*.pyc

# Left behind by `uv pip install -e .` - build metadata, not source
*.egg-info/

# Runtime state: the pet itself. Generated on first run, and personal.
bridge/buddy.json
bridge/buddy.json.bak
bridge/buddy.json.tmp

# Written by device/deploy_app.sh on whichever machine it runs on
device/backup/

# Sprite previews are regenerated by tools/sprite_convert.py --png
/preview/

# device/sprites/*.spr is deliberately NOT ignored: committing it means a user
# can deploy without installing Pillow, and the files are a few hundred bytes.
